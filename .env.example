DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/DATABASE"
BETTER_AUTH_SECRET="generate-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# SMTP (obligatoire en production pour l'envoi réel des e-mails)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="HashCode Sync <no-reply@example.com>"

# Resend (alternative à SMTP, optionnel)
RESEND_API_KEY=""
RESEND_FROM="HashCode Sync <no-reply@example.com>"

# Cron secret pour les rappels automatiques (à générer aléatoirement)
CRON_SECRET=""

# Timezone par défaut de l'application
DEFAULT_TIMEZONE="Africa/Porto-Novo"

# TZ environnant pour garantir un comportement serveur stable
TZ="Africa/Porto-Novo"
